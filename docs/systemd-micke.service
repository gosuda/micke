# docs/systemd-micke.service — example systemd USER unit for the micke daemon.
#
# The daemon does not supervise itself (docs/research/http-daemon-design.md
# §10): this unit is the documented way to keep it up.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp docs/systemd-micke.service ~/.config/systemd/user/micke.service
#   # adjust the repo path in ExecStart below to yours, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now micke
#
# Notes:
# - `rungv` (gvx v0.4.x) must be on PATH. Add its directory to
#   Environment=PATH= below if your user unit does not inherit your shell PATH
#   (or set MICKE_RUNGV=/absolute/path/to/rungv).
# - Sandboxes deliberately outlive the daemon: Restart=on-failure restarts
#   micke without losing desktops, and the next start adopts them from their
#   pidfiles. rungv needs no daemon or root.
# - MICKE_PORT (default 7800) is the one port for MCP (POST /mcp) and the
#   dashboard (GET /), bound to 127.0.0.1 only.

[Unit]
Description=micke desktop supervisor (MCP over HTTP + dashboard)
Documentation=file://%h/git/micke/docs/server-internals.md

[Service]
ExecStart=%h/.bun/bin/bun run %h/git/micke/src/main.ts
Restart=on-failure
# Comfortably above the 120 s session_shell cap so an in-flight command can
# finish during shutdown before systemd escalates to SIGKILL.
TimeoutStopSec=180
Environment=MICKE_PORT=7800

[Install]
WantedBy=default.target
