#!/bin/sh
# micke-find — find a clickable ref by name from a snapshot, never from `find`.
#
# WHY: `agent-desktop find` on a heavy page wants two consecutive stable passes
# of a ~1150-node tree that keeps mutating. It burns the budget and returns
# TIMEOUT even while its own receipt admits it observed matches. One snapshot
# plus a filter IN the guest is ~5 s and a few KB, and the ref it prints feeds
# `click` directly. This wraps that loop, with a bounded retry ladder that
# fires only when the snapshot receipt says truncated:true.
#
# stdout: REF<TAB>ROLE<TAB>NAME per match, or a JSON array with --json.
# Exit 0 on a match, 1 when nothing matched, 2 on bad usage. Writes no files.
#
# See docs/chromium-flags.md ("Finding a click target on a heavy page").

set -u

usage() {
    cat <<'EOF'
usage: micke-find <name-substring> [options]

  --role ROLE      only elements with this role (e.g. link, button)
  --limit N        maximum matches to print (default 10)
  --root @SNAP:REF scope the snapshot to an existing ref
  --budget MS      first snapshot deadline (default 5000)
  --json           print a JSON array instead of REF<TAB>ROLE<TAB>NAME
  -h, --help       this help

Matches are case-insensitive substrings of the element name. A truncated
snapshot with no match retries once at 10000 ms, then once at 20000 ms.
EOF
}

name=""
role=""
limit=10
root=""
budget=5000
json=0

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --role)
            [ $# -ge 2 ] || { echo "micke-find: --role needs a value" >&2; exit 2; }
            role=$2; shift 2 ;;
        --limit)
            [ $# -ge 2 ] || { echo "micke-find: --limit needs a value" >&2; exit 2; }
            limit=$2; shift 2 ;;
        --root)
            [ $# -ge 2 ] || { echo "micke-find: --root needs a value" >&2; exit 2; }
            root=$2; shift 2 ;;
        --budget)
            [ $# -ge 2 ] || { echo "micke-find: --budget needs a value" >&2; exit 2; }
            budget=$2; shift 2 ;;
        --json) json=1; shift ;;
        --) shift; break ;;
        -*) echo "micke-find: unknown option $1" >&2; exit 2 ;;
        *)
            [ -z "$name" ] || { echo "micke-find: unexpected argument $1" >&2; exit 2; }
            name=$1; shift ;;
    esac
done

if [ -z "$name" ] && [ $# -gt 0 ]; then
    name=$1
fi

if [ -z "$name" ]; then
    usage >&2
    exit 2
fi

case "$limit" in
    ''|*[!0-9]*) echo "micke-find: --limit must be a positive integer" >&2; exit 2 ;;
esac
[ "$limit" -gt 0 ] || { echo "micke-find: --limit must be a positive integer" >&2; exit 2; }

case "$budget" in
    ''|*[!0-9]*) echo "micke-find: --budget must be a positive integer" >&2; exit 2 ;;
esac
[ "$budget" -gt 0 ] || { echo "micke-find: --budget must be a positive integer" >&2; exit 2; }

# A single extraction expression, reused for output and for the empty check.
EXTRACT='
  [ .data.tree | .. | objects
    | select((.ref_id? // "") != "")
    | select((.name? // "") != "")
    | select((.name | ascii_downcase) | contains(($q | ascii_downcase)))
    | select($role == "" or (.role? // "") == $role)
    | {ref: .ref_id, role: (.role? // ""), name: .name}
  ] | .[:$limit]
'

matches="[]"
tried=""
last=0
error=""

for b in "$budget" 10000 20000; do
    # Never repeat or lower a budget: a custom --budget above 10000 just runs once.
    [ "$b" -gt "$last" ] || continue
    last=$b
    tried="${tried:+$tried/}$b"

    if [ -n "$root" ]; then
        snap=$(agent-desktop snapshot --app chromium -i --compact \
            --root "$root" --timeout-ms "$b" 2>/dev/null)
    else
        snap=$(agent-desktop snapshot --app chromium -i --compact \
            --timeout-ms "$b" 2>/dev/null)
    fi
    rc=$?

    if [ "$rc" -ne 0 ] || [ -z "$snap" ]; then
        error=$(printf '%s' "$snap" | jq -r '.error.code // empty' 2>/dev/null)
        [ -n "$error" ] || error="snapshot failed (rc=$rc)"
        break
    fi

    matches=$(printf '%s' "$snap" | jq -c \
        --arg q "$name" --arg role "$role" --argjson limit "$limit" \
        "$EXTRACT" 2>/dev/null) || matches="[]"

    [ "$matches" != "[]" ] && break

    # Retry only when the tree was actually cut short. A complete tree with no
    # match means the element is not there; spending 20 s would not change that.
    truncated=$(printf '%s' "$snap" | jq -r '(.data.truncated // false) | tostring' 2>/dev/null)
    [ "$truncated" = "true" ] || break
done

if [ "$matches" = "[]" ] || [ -z "$matches" ]; then
    what="name containing \"$name\""
    [ -n "$role" ] && what="$what (role=$role)"
    suffix=""
    [ -n "$error" ] && suffix=" (last error: $error)"
    echo "micke-find: no element with $what; tried snapshot budgets ${tried} ms${suffix}" >&2
    exit 1
fi

if [ "$json" -eq 1 ]; then
    printf '%s\n' "$matches"
else
    printf '%s' "$matches" | jq -r '.[] | [.ref, .role, .name] | @tsv'
fi
