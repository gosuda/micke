#!/bin/sh
# micke-key — deliver ONE key combo to the chromium window with xdotool.
#
# WHY: `agent-desktop press` SIGSEGVs chromium on this image: 25 of 29
# delivered presses killed the browser process with rc 139, including a bare
# `a`, `ctrl+r`, `F5` and `ctrl+w`. The X events are identical (xev reports
# `synthetic NO` and the same keycode/state); the difference is that `press`
# goes through the AT-SPI DeviceEventController.NotifyListenersSync path, and
# the browser's D-Bus name disappears ~40 ms later. `xdotool key
# --clearmodifiers` is the same keystroke without that round trip: 0 crashes
# in 20+ attempts, including 3 ctrl+r reloads of naver.com. `click` is not
# affected. Dropping --force-renderer-accessibility would "fix" it too, but
# that destroys the refs the whole driving loop depends on.
#
# xdotool gives no receipt, so this proves DELIVERY, not effect: confirm the
# reload/navigation with `micke-state` (title/url/refs) or
# `agent-desktop wait --window`.
#
# Input goes to the window with X input focus, so resolve chromium, activate
# it, and verify the active window id before sending — never whatever happens
# to have focus (a human's noVNC click can steal it).
#
# Usage:
#   micke-key ctrl+r            # one combo; xdotool key syntax
#   micke-key ctrl+shift+q
#   micke-key -h                # this text; sends nothing
#
# stdout: one line, e.g. {"sent":true,"combo":"ctrl+r","window":"NAVER - Chromium"}
# Exit 2 on bad usage, 1 when no chromium window can be resolved or activated.

set -eu

usage() {
    cat <<'EOF'
usage: micke-key <combo>

  ctrl+r            reload (xdotool key syntax)
  F5                the same, without the modifier
  ctrl+shift+q      quit the browser

Sends ONE combo to the chromium window with `xdotool key --clearmodifiers`,
after activating that window and verifying it has focus. Prints one line of
JSON on success. Delivery only — verify the effect with `micke-state`.
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    "") usage >&2; exit 2 ;;
esac

if [ $# -ne 1 ]; then
    echo "micke-key: exactly one combo (got $# arguments)" >&2
    exit 2
fi
combo=$1

command -v xdotool >/dev/null 2>&1 \
    || { echo "micke-key: xdotool is not installed" >&2; exit 1; }

# First visible window whose title carries the app name. A dead browser leaves
# no window at all — this is the loud failure the a11y surfaces don't give.
win=$(xdotool search --onlyvisible --name 'Chromium' 2>/dev/null | head -n 1)
if [ -z "$win" ]; then
    echo "micke-key: no chromium window on ${DISPLAY:-<no DISPLAY>} (browser dead or never launched; relaunch with micke-chromium <url>)" >&2
    exit 1
fi

title=$(xdotool getwindowname "$win" 2>/dev/null || true)

# `key` follows X input focus, not the id we resolved, so activate and check.
xdotool windowactivate --sync "$win" 2>/dev/null || true
active=$(xdotool getactivewindow 2>/dev/null || true)
if [ "$active" != "$win" ]; then
    echo "micke-key: could not focus chromium window $win (active: ${active:-none}); nothing sent" >&2
    exit 1
fi

xdotool key --clearmodifiers "$combo" \
    || { echo "micke-key: xdotool rejected combo '$combo'" >&2; exit 1; }

# Hand-rolled escaping keeps the dependency list at xdotool alone.
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
printf '{"sent":true,"combo":"%s","window":"%s"}\n' "$(esc "$combo")" "$(esc "$title")"
